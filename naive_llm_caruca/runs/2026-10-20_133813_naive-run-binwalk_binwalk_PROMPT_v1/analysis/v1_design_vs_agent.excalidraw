   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "What changes with a command like binwalk. Its behaviour depends on what is inside its input files, it can run other programs (-D, and -e's extraction tools), and it ships as\nreadable source. v1's design treats commands as opaque, varies paths more than contents, and was evaluated on 120 commands that do not include binwalk.",
   "originalText": "What changes with a command like binwalk. Its behaviour depends on what is inside its input files, it can run other programs (-D, and -e's extraction tools), and it ships as\nreadable source. v1's design treats commands as opaque, varies paths more than contents, and was evaluated on 120 commands that do not include binwalk.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "width": 1557,
   "height": 38
  },
  {
   "id": "footer",
   "type": "text",
   "x": 40,
   "y": 736,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 100106,
   "version": 1,
   "versionNonce": 100107,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
