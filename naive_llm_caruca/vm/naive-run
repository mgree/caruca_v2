#!/usr/bin/env bash
# Run one experiment session in this VM. Installed at ~/bin/naive-run by new_run_vm.sh.
#
#   naive-run <command> [PROMPT_vN.md]        watch mode (default): the session runs non-interactively with
#                                             permissions bypassed; every tool call, its input and its result
#                                             are shown live and logged
#   naive-run -i <command> [PROMPT_vN.md]     interactive: Claude Code's own screen; the prompt is put in the
#                                             input box, press Enter to send it; you answer permission prompts
#
# Every invocation gets its own folder, ~/runs/<date>_<time>_<vm>_<command>_<version>/, holding
# everything about that run: the exact prompt sent, the deliverables (moved out of ~/naive-arm/output),
# the raw event stream, the rendered action log, Claude Code's own session transcript, and run.env with
# the metadata. Two invocations in the same clone give two folders; the second runs in an environment
# the first has already touched, which run.env records (run_number_in_this_clone).
#
# Prompts are read from ~/prompts and runs written to ~/runs: both outside ~/naive-arm, the folder the
# session works in, so it cannot read the other prompt versions or any run's records.
# Default prompt version: PROMPT_v1.md. Any installed command is allowed. A command outside the
# project's core nine (cat grep pwd rm tac tail tee uniq wc) asks for confirmation first; one of the
# four samples (tee uniq grep rm) gets a note, since the session has its finished answer in samples/.
#
# Model: a one-line trial call checks whether this account can use claude-fable-5-1; if it can, the run
# uses it at medium effort, otherwise claude-opus-5-5 at high effort. No --fallback-model: effort is set
# once per session, so a mid-run switch would run Opus at medium and mix two models in one run.
# No web lookups (Tiran, 2026-10-20): WebSearch, WebFetch and RemoteTrigger (cloud agents) are removed and
# no MCP servers are loaded (--strict-mcp-config), in both modes. The network itself is left open so
# programs that need it (a package installer) still work; the prompt tells the session not to read
# anything online, and after the run every http(s) URL in its Bash commands is listed in bash_urls.txt.
set -euo pipefail
cd ~/naive-arm
MODE=watch
if [ "${1:-}" = "-i" ]; then MODE=interactive; shift; fi
CMD="${1:?usage: naive-run [-i] <command> [PROMPT_vN.md]}"
P="$HOME/prompts/$(basename "${2:-PROMPT_v1.md}")"
[ -f "$P" ] || { echo "error: no such prompt file: $(basename "$P") (have: $(cd ~/prompts && ls PROMPT_v*.md | tr '\n' ' '))" >&2; exit 2; }
CORE_NINE="cat grep pwd rm tac tail tee uniq wc"
case " $CORE_NINE " in *" $CMD "*) ;; *)
  echo "warning: $CMD is not one of the core nine ($CORE_NINE); results will not line up with the v1/v2 parity runs." >&2
  if [ -t 0 ]; then
    read -r -p "Run it anyway? [y/N] " ANSWER
    case "$ANSWER" in y|Y|yes|YES) ;; *) echo "aborted." >&2; exit 3;; esac
  else
    echo "error: no terminal to confirm on; re-run from an interactive shell" >&2; exit 3
  fi
  ;;
esac
case "$CMD" in tee|uniq|grep|rm) echo "note: $CMD is one of the samples, so the session can see a finished answer for it in samples/" >&2;; esac
BIN="$(command -v "$CMD" || true)"; MAN="$(man -w "$CMD" 2>/dev/null || true)"
[ -n "$BIN" ] || { echo "error: $CMD is not installed in this VM" >&2; exit 2; }
[ -n "$MAN" ] || { echo "error: no manual page for $CMD in this VM" >&2; exit 2; }

# a signed-out clone must stop here: otherwise the model trial call fails and looks like "no Fable access"
claude auth status 2>/dev/null | grep -q '"loggedIn": true' || { echo "error: Claude Code is not signed in in this VM (claude auth status); sign in (claude, then /login) and rerun" >&2; exit 4; }
VM="$(hostname | sed 's/^lima-//')"
PVER="$(basename "${P%.md}")"
STAMP="$(date +%Y-%m-%d_%H%M%S)"
RUN="$HOME/runs/${STAMP}_${VM}_${CMD}_${PVER}"
mkdir -p "$RUN" "$HOME/runs"
N=$(find "$HOME/runs" -mindepth 1 -maxdepth 1 -type d | wc -l)   # this run included
mkdir -p output
if [ -n "$(ls -A output 2>/dev/null)" ]; then
  echo "warning: output/ was not empty; moving leftovers to $RUN/leftover_output_before_run/" >&2
  mkdir -p "$RUN/leftover_output_before_run" && mv output/* output/.[!.]* "$RUN/leftover_output_before_run/" 2>/dev/null || true
fi
PROMPT="$(sed -e "s|{{COMMAND}}|$CMD|g" -e "s|{{PATH}}|$BIN|g" -e "s|{{MANPAGE_PATH}}|$MAN|g" "$P")"
printf '%s\n' "$PROMPT" > "$RUN/prompt.md"
# choose the model before the start mark, so the trial call's session is not copied as a run transcript
PROBE="$(claude -p "Reply with the single word OK." --model claude-fable-5-1 --effort medium --tools "" \
  --system-prompt "You reply with the single word OK." --strict-mcp-config --disable-slash-commands \
  --output-format json --no-session-persistence 2>&1 || true)"
if WHY="$(printf '%s' "$PROBE" | python3 -c '
import json, sys
try: d = json.loads(sys.stdin.read().strip().splitlines()[-1])
except Exception as e: print(f"unreadable trial reply: {e}"); sys.exit(1)
if d.get("is_error") or "claude-fable-5-1" not in d.get("modelUsage", {}): print(str(d.get("result", "")).replace("\n", " ")[:200]); sys.exit(1)
')"; then
  MODEL=claude-fable-5-1; EFFORT=medium; CHOICE="fable-ok"
else
  case "$WHY" in *[Aa]uthenticat*|*OAuth*|*[Ll]og\ in*|*/login*)
    echo "error: the model trial call failed on sign-in, not on model access: $WHY" >&2; rm -rf "$RUN"; exit 4;; esac
  MODEL=claude-opus-5-5; EFFORT=high; CHOICE="fallback ($WHY)"
fi
NO_WEB=(--disallowedTools WebSearch WebFetch RemoteTrigger --strict-mcp-config)
START_MARK="$RUN/.start"; touch "$START_MARK"
{
  echo "command=$CMD"; echo "prompt_version=$PVER"; echo "prompt_file=$P"; echo "binary=$BIN"; echo "manpage=$MAN"
  echo "mode=$MODE"; echo "vm=$VM"; echo "run_number_in_this_clone=$N"
  echo "started=$(date -Is)"; echo "claude=$(claude --version)"; echo "os=$(lsb_release -ds) $(uname -m)"
  echo "model=$MODEL"; echo "effort=$EFFORT"; echo "model_choice=$CHOICE"
  echo "disallowed_tools=WebSearch WebFetch RemoteTrigger"; echo "mcp=none (strict)"
} > "$RUN/run.env"
[ "$N" -gt 1 ] && echo "note: run #$N in this clone; the environment is not fresh (earlier runs: $(ls ~/runs | grep -v "^$(basename "$RUN")$" | tr '\n' ' '))" >&2

echo "== run folder: $RUN"
echo "== $MODE run of $CMD with $PVER (binary $BIN, man $MAN)"
echo "== model $MODEL, effort $EFFORT ($CHOICE); web tools and MCP servers off"
if [ "$MODE" = watch ]; then
  echo "permission_mode=bypassPermissions" >> "$RUN/run.env"
  echo "== permissions are bypassed (throwaway VM); every action is shown below as it happens"
  claude -p "$PROMPT" --model "$MODEL" --effort "$EFFORT" "${NO_WEB[@]}" \
    --output-format stream-json --verbose --permission-mode bypassPermissions \
    | python3 ~/bin/naive-watch.py "$RUN/stream.jsonl" || echo "exit_status=$?" >> "$RUN/run.env"
else
  echo "permission_mode=interactive" >> "$RUN/run.env"
  echo "== interactive. The prompt is placed in the input box: press Enter to send it. Exit with /exit."
  claude "$PROMPT" --model "$MODEL" --effort "$EFFORT" "${NO_WEB[@]}" || echo "exit_status=$?" >> "$RUN/run.env"
fi
echo "finished=$(date -Is)" >> "$RUN/run.env"

# deliverables: move out of the work folder into the run folder, leaving output/ empty for the next run
mkdir -p "$RUN/output"
if [ -n "$(ls -A output 2>/dev/null)" ]; then mv output/* output/.[!.]* "$RUN/output/" 2>/dev/null || true; fi
# Claude Code's own transcript(s) of this run: every session file written since the run started
find ~/.claude/projects -name '*.jsonl' -newer "$START_MARK" 2>/dev/null | while read -r T; do
  cp "$T" "$RUN/transcript_$(basename "$T")"; echo "transcript=$T" >> "$RUN/run.env"
done
rm -f "$START_MARK"
# every http(s) URL in the session's Bash commands, from the raw stream (watch) or the transcript(s) (interactive)
python3 - "$RUN" > "$RUN/bash_urls.txt" <<'PY'
import glob, json, os, re, sys
run = sys.argv[1]
files = [os.path.join(run, "stream.jsonl")] + sorted(glob.glob(os.path.join(run, "transcript_*.jsonl")))
src = next((f for f in files if os.path.exists(f)), None)
seen = []
for line in open(src, encoding="utf-8") if src else []:
    try: r = json.loads(line)
    except json.JSONDecodeError: continue
    m = r.get("message") if isinstance(r.get("message"), dict) else {}
    for b in m.get("content") or []:
        if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") == "Bash":
            for u in re.findall(r"https?://[^\s\"'`)>|;]+", str((b.get("input") or {}).get("command", ""))):
                if u not in seen: seen.append(u)
if seen: print("\n".join(seen))
PY
echo "bash_urls=$(grep -c . "$RUN/bash_urls.txt" || true)" >> "$RUN/run.env"
if [ -s "$RUN/bash_urls.txt" ]; then echo "== URLs in the session's Bash commands (bash_urls.txt):"; sed 's/^/   /' "$RUN/bash_urls.txt"
else echo "== no URLs in the session's Bash commands"; fi
echo "== done. Run folder contents:"; find "$RUN" -type f | sort | sed "s|$HOME/||"
